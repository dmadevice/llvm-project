; RUN: llc < %s -mtriple=aarch64-unknown-linux | FileCheck %s

; Test signed division by constants whose magic requires a numerator add-back
; or subtract. AArch64 has no native 32-bit MULHS, so the exact (N+1)-bit magic
; can be used with a wider multiply instead of smull plus add-back
; (issue #238449).

; Positive divisors whose 32-bit signed magic is negative (needs the numerator
; add-back).

define i32 @sdiv_by_7(i32 %x) nounwind {
; CHECK-LABEL: sdiv_by_7:
; CHECK:       // %bb.0:
; CHECK-NEXT:    // kill: def $w0 killed $w0 def $x0
; CHECK-NEXT:    sxtw x8, w0
; CHECK-NEXT:    mov w9, #9363 // =0x2493
; CHECK-NEXT:    movk w9, #37449, lsl #16
; CHECK-NEXT:    mul x8, x8, x9
; CHECK-NEXT:    lsr w9, w0, #31
; CHECK-NEXT:    add x0, x9, x8, asr #34
; CHECK-NEXT:    // kill: def $w0 killed $w0 killed $x0
; CHECK-NEXT:    ret
  %div = sdiv i32 %x, 7
  ret i32 %div
}

